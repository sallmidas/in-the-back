# Fast path: hide the labeled DEMO workplaces.
# Copy this file to `.env.local`, set 0, then `npm run dev`.
# Default (unset or 1): labeled DEMO seed is on.
# `npm run dev` also starts the local API. Filings are stored in data/board.json.
# Hard path: empty DEMO_WORKPLACES / DEMO_REPORTS in src/data/seed.ts.
VITE_DEMO_SEED=1
