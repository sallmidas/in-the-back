# Demo workplaces are off unless you opt in.
# They are sample data, not live reviews. A production build omits them
# unless this is set to exactly 1 when Vite builds.
# VITE_DEMO_SEED=1

# `npm run dev` starts the local API. Filings are stored in data/board.json.

# Chair account email. Set this on a public host to Saul's chair account.
# Leave unset locally to keep confirm-to-claim. See DEPLOY.md.
# ITB_CHAIR_EMAIL=

# DOL open-data key for OSHA and Wage and Hour imports. Leave unset to skip the download.
# DOL_API_KEY=
# Hide public records older than this many years. Default is 5.
# ITB_RECORD_MAX_AGE_YEARS=5
